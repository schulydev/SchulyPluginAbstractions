<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Schuly.Plugin.Abstractions</PackageId>
    <Description>Plugin contract for the Schuly backend</Description>
    <Authors>schulydev</Authors>
    <PackageProjectUrl>https://github.com/schulydev/SchulyPluginAbstractions</PackageProjectUrl>
    <RepositoryUrl>https://github.com/schulydev/SchulyPluginAbstractions</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>schuly;plugin;abstractions</PackageTags>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
